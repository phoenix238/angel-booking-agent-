{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/fetch-rss",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/radar",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/recast",
      "schedule": "30 5 1 * *"
    },
    {
      "path": "/api/cron/mail",
      "schedule": "30 6 * * *"
    }
  ]
}
