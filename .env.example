# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Optional: model used for scoring (default claude-opus-5-5; claude-haiku-5-5 is much cheaper)
ANTHROPIC_MODEL=

# Shared secrets (any long random string, e.g. `openssl rand -hex 32`)
CRON_SECRET=
EMAIL_WEBHOOK_SECRET=

# Inbound email domain pointed at SendGrid Inbound Parse (MX record)
INBOUND_EMAIL_DOMAIN=in.example.com
# Local part for generated list addresses: auditions+<list>@INBOUND_EMAIL_DOMAIN
INBOUND_EMAIL_LOCAL=auditions

# Who may log in (comma separated)
ALLOWED_EMAILS=you@example.com

# Public site address, used in login links (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daily digest email (any SMTP; Gmail needs an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Digest on/off and recipients are set on the Settings page.

# Angel's own inbox (a dedicated mailbox, never an everyday one): casting newsletters are
# subscribed with plus addresses, e.g. yourangel+spotlight@gmail.com. Gmail needs 2-step
# verification and an app password.
IMAP_USER=
IMAP_PASS=
IMAP_HOST=imap.gmail.com

# Angel's address shown on the Emails tab. Set it when mail arrives at a different address than
# the mailbox login (e.g. Cloudflare Email Routing, angel@in.yourdomain.com). Optional otherwise.
ANGEL_EMAIL=
# Throwaway stopgap inbox on mail.tm (can vanish without notice; fine for testing only).
MAILTM_USER=
MAILTM_PASS=
